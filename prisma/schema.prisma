generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  email        String        @unique
  passwordHash String?
  authProvider LoginProvider @default(EMAIL)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  reports Report[]
}

model Report {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  latitude  Float
  longitude Float
  severity  ReportSeverity
  comment   String?
  imageUrl  String?
  status    ReportStatus   @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([status, createdAt])
}

enum LoginProvider {
  EMAIL
  GOOGLE
}

enum ReportSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ReportStatus {
  ACTIVE
  HIDDEN
}
